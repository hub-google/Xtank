{
  "name": "xtank-revival",
  "productName": "X-TANK Revival Prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent X-TANK-inspired playable 3D desktop prototype",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test": "node --test",
    "build": "vite build",
    "desktop": "npm run build && electron .",
    "dist:win": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "vite": "^7.1.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "io.github.hubgoogle.xtank.revival",
    "productName": "X-TANK Revival",
    "directories": {"output": "release"},
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "asar": true,
    "win": {
      "target": [{"target": "portable", "arch": ["x64"]}],
      "artifactName": "XTANK-Prototype-${version}-Windows.exe"
    }
  }
}
